<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="weltpixel" translate="label" sortOrder="900">
            <label>WeltPixel</label>
        </tab>
        <section id="weltpixel_shopifycheckout" translate="label" type="text" sortOrder="900" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>WeltPixel Shopify Checkout</label>
            <tab>weltpixel</tab>
            <resource>WeltPixel_ShopifyCheckout::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Shopify Checkout</label>
                    <comment>Controls whether the Shopify checkout handoff is enabled for this scope.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="environment" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Active Environment</label>
                    <comment>Select which credential set is used for API calls.</comment>
                    <source_model>WeltPixel\ShopifyCheckout\Model\Config\Source\Environment</source_model>
                </field>
                <field id="checkout_behavior" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Proceed to Checkout Behavior</label>
                    <comment>Choose whether to show a separate Shopify button or replace Magento&apos;s default checkout buttons.</comment>
                    <source_model>WeltPixel\ShopifyCheckout\Model\Config\Source\CheckoutBehavior</source_model>
                </field>
                <field id="create_products_before_checkout" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Create product in Shopify to use image on checkout</label>
                    <comment>To allow images on the Shopify checkout, Shopify needs an associated product. When this setting is enabled, the product in the cart is automatically created in Shopify (reused if it already exists) to ensure Shopify can pull all the required details on the checkout, including the image.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
            <group id="sandbox_credentials" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Sandbox Credentials</label>
                <field id="store_domain" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Shopify Store Domain</label>
                    <comment>Enter the myshopify.com domain associated with the sandbox store credentials.</comment>
                </field>
                <field id="access_token" translate="label" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Admin Access Token</label>
                    <comment>Secure Admin REST access token generated from the sandbox Shopify store.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="webhook_secret" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Webhook Shared Secret</label>
                    <comment>Signature secret used to verify incoming sandbox webhook requests.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="create_webhook_sandbox" translate="label" type="note" sortOrder="30" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Create Sandbox Webhooks</label>
                    <comment>Registers Shopify sandbox webhooks that target this Magento instance.</comment>
                    <frontend_model>WeltPixel\ShopifyCheckout\Block\Adminhtml\System\Config\WebhookButton</frontend_model>
                </field>
            </group>
            <group id="production_credentials" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Production Credentials</label>
                <field id="store_domain" translate="label" type="text" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Shopify Store Domain</label>
                    <comment>Enter the myshopify.com domain associated with the live store credentials.</comment>
                </field>
                <field id="access_token" translate="label" type="obscure" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Admin Access Token</label>
                    <comment>Secure Admin REST access token generated from the production Shopify store.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="webhook_secret" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Webhook Shared Secret</label>
                    <comment>Signature secret used to verify incoming production webhook requests.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="create_webhook_production" translate="label" type="note" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Create Production Webhooks</label>
                    <comment>Registers Shopify production webhooks that target this Magento instance.</comment>
                    <frontend_model>WeltPixel\ShopifyCheckout\Block\Adminhtml\System\Config\WebhookButton</frontend_model>
                </field>
            </group>
        </section>
    </system>
</config>
